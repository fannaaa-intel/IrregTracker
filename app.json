{
  "expo": {
    "name": "Cycle Tracker",
    "slug": "cycle-tracker",
    "owner": "sersi07",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cycletracker",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8FA",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fannaaa.cycle"
    },
    "android": {
      "package": "com.fannaaa.cycle",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FCE8EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1C1418"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/601e0cbe-9783-422c-acaf-009f9cc945bc"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "601e0cbe-9783-422c-acaf-009f9cc945bc"
      }
    }
  }
}
